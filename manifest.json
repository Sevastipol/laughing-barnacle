{
  "manifest_version": 3,
  "name": "Script Injector",
  "version": "1.0",
  "description": "Injects a custom script into every webpage.",
  "permissions": [
    "activeTab",
    "scripting",
    "http://*/",
    "https://*/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
