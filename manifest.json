{
  "manifest_version": 3,
  "name": "Pickaxe AI Overlay",
  "version": "1.0",
  "description": "Injects Pickaxe AI embed with Ctrl+A toggle",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": [],
  "host_permissions": [
    "*://*/*"
  ],
  "icons": {
    "128": "icon.png"
  }
}
